# Application path (not hostname or IP); used by Vite and React Router.
VITE_APP_BASE_PATH=/console/

# Local development ONLY: Vite proxy target, never used in production browser requests.
VITE_LARAVEL_TARGET=http://127.0.0.1:8000

VITE_ENABLE_SIGNUP=false
# Optional endpoint relative to /api/v1 (leave blank until Laravel implements it).
VITE_SETTINGS_READ_ENDPOINT=
VITE_DEVELOPER_NAME=Sinan
VITE_CONTACT_EMAIL=
VITE_CONTACT_GITHUB=https://github.com/Szeenaaan
VITE_COPYRIGHT_TEXT="© 2026 Sinan Sinu. All rights reserved."
